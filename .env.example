# Mena Cumples - variables de entorno requeridas
# Copia este archivo a .env (local) o configura estas variables en Reflex Cloud (producción)

# Supabase - mismas credenciales que el proyecto hotel_mena_plaza_web
SUPABASE_URL=

# Clave de servicio (service_role). OBLIGATORIA: con la anon el gate de códigos
# no funciona, porque el RLS cerrado en las migraciones 006/007 de
# hotel_mena_plaza_web borró las policies anon de cumples_pedidos.
SUPABASE_SERVICE_KEY=

# Solo desarrollo local sin clave de servicio. NO usar en producción.
SUPABASE_KEY=
